# ============================================
# JWT Configuration
# ============================================
SECRET_KEY=change-me-in-production-use-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Backward-compatible aliases (optional)
# JWT_SECRET=${SECRET_KEY}
# JWT_ALGORITHM=${ALGORITHM}
DEBUG=True

# ============================================
# Database Configuration
# ============================================
# Local SQLite (default)
DATABASE_URL=sqlite:///./test.db

# AWS RDS PostgreSQL (production)
# DATABASE_URL=postgresql://username:password@fieldfix-db.xxxxxx.us-east-1.rds.amazonaws.com:5432/fieldfix

# ============================================
# AWS Cognito (Identity Provider)
# ============================================
# REQUIRED: AWS Cognito user pool details
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=your-app-client-id-here
# Optional: Auto-generated if not provided
# COGNITO_JWKS_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX/.well-known/jwks.json

# ============================================
# Google OAuth & APIs
# ============================================
# Note: Google login now federated through Cognito
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_MAPS_API_KEY=your-maps-api-key-here
GOOGLE_API_KEY=your-gemini-api-key-here

# ============================================
# Frontend URLs
# ============================================
FRONTEND_URL=http://localhost:5173
TECHNICIAN_FRONTEND_URL=http://localhost:5174

# ============================================
# AWS S3 Configuration (File Uploads)
# ============================================
AWS_S3_BUCKET_NAME=fieldfix-uploads-prod
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
ENABLE_S3_UPLOAD=False

# ============================================
# AWS SNS Configuration (Emergency Alerts)
# ============================================
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:fieldfix-emergency-alerts
ENABLE_SNS_ALERTS=False

# ============================================
# Facebook OAuth (Optional)
# ============================================
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
