# SMS/OTP Configuration - Add to backend/.env

# ============================================
# OPTION 1: MSG91 (Recommended for India)
# ============================================
# Sign up: https://msg91.com/
# Get API key from: https://control.msg91.com/user/api.php

MSG91_API_KEY=your_msg91_api_key_here
MSG91_SENDER_ID=FYXION
MSG91_OTP_TEMPLATE_ID=your_otp_template_id
MSG91_FLOW_ID=your_flow_id_for_notifications
ENABLE_SMS=True

# ============================================
# OPTION 2: Twilio
# ============================================
# Sign up: https://www.twilio.com/try-twilio
# Get credentials from: https://console.twilio.com/

# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
# ENABLE_SMS=True

# ============================================
# OPTION 3: AWS SNS (if using AWS)
# ============================================
# Already configured above in AWS Configuration section
# Just set ENABLE_SMS=True

# ============================================
# Testing Mode (No SMS provider needed)
# ============================================
# Keep ENABLE_SMS=False
# OTP will be logged to console in development
# ENABLE_SMS=False
