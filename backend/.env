# ============================================================
# FIXORA Backend — Environment Configuration
# ============================================================
# Fill in YOUR credentials below. The app works locally with
# defaults (SQLite, local storage, console alerts).
# Enable AWS services by setting ENABLE_* flags to True
# after configuring the corresponding AWS credentials.
# ============================================================

# ----- JWT Authentication -----
JWT_SECRET=your-super-secret-key-change-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----- Server -----
DEBUG=True

# ----- Database -----
# Local (default): SQLite
DATABASE_URL=sqlite:///./test.db
# Production: Uncomment and fill in your RDS credentials
# DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_RDS_ENDPOINT:5432/fixora

# ----- Google OAuth -----
GOOGLE_CLIENT_ID=308647868127-8n8vb7950h978fcm5kpjii07fir6005n.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=MY_GOOGLE_CLIENT_SECRET
GOOGLE_MAPS_API_KEY=MY_GOOGLE_MAPS_KEY

# ----- Gemini Vision AI -----
GOOGLE_API_KEY=MY_GOOGLE_API_KEY

# ----- Frontend URLs -----
FRONTEND_URL=http://localhost:5173
TECHNICIAN_FRONTEND_URL=http://localhost:5174

# ----- AWS Core Credentials -----
# Get these from AWS IAM Console → Users → Security credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ----- AWS S3 (File Storage) -----
# Create bucket in S3 Console, then paste the name here
AWS_S3_BUCKET_NAME=
# Set to True AFTER creating the S3 bucket and filling credentials above
ENABLE_S3_UPLOAD=False

# ----- AWS SNS (Notifications) -----
# Create SNS topic, then paste the ARN here
AWS_SNS_TOPIC_ARN=
# Set to True AFTER creating the SNS topic and filling credentials above
ENABLE_SNS_ALERTS=False

# ----- AWS Cognito (Future Auth) -----
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=